# Public site origin — canonical URLs, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API Keys
# Use the PUBLISHABLE key (sb_publishable_...). It is shipped to the browser
# and is governed by row level security. Never put a secret or service_role
# key here: those bypass RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# FRED — macro series (CPI, rates) for the inflation-adjusted toggle.
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
